{
  "name": "play-store-miner",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "productName": "Play Store Miner",
  "main": "desktop/main.js",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "test": "npm test -w server",
    "desktop:package": "npm run build && electron-forge package --platform=darwin --arch=arm64",
    "desktop:migrate-data": "node desktop/move-existing.js"
  },
  "dependencies": {"express": "^5.1.0"},
  "devDependencies": {"concurrently": "^9.2.1", "electron": "43.2.0", "@electron-forge/cli": "7.11.2"},
  "overrides": {"extract-zip": "npm:@electron-internal/extract-zip@1.0.1"}
}
